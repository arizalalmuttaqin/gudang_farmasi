<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Obat Keluar</title>
    <!-- Menggunakan Tailwind CSS via CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-gray-50 text-gray-800">

    <main class="max-w-xl mx-auto px-4 sm:px-6 py-10">
        
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
            <!-- Header Form -->
            <div class="px-6 py-5 border-b border-gray-200 bg-yellow-50/50">
                <h2 class="text-xl font-bold text-gray-900">Edit Riwayat Obat Keluar</h2>
                <p class="text-sm text-gray-500 mt-1">Perbarui jumlah, tanggal, atau keterangan pengeluaran obat.</p>
            </div>

            <!-- Form Body (Tag Form Diperbaiki) -->
            <form action="/edit_keluar/<%= dataObat.id_keluar %>" method="POST" class="p-6 space-y-6">
                
                <!-- Input ID Obat (Dibuat Readonly agar ID obat tidak bisa diubah seenaknya saat edit) -->
                <div>
                    <label class="block text-sm font-medium text-gray-700">ID Obat</label>
                    <div class="mt-1">
                        <!-- Menampilkan ID obat lama. Anda tidak perlu dropdown di sini untuk mencegah kekacauan relasi data -->
                        <input type="text" value="<%= dataObat.id_obat %>" readonly
                            class="block w-full px-4 py-2.5 bg-gray-100 border border-gray-200 rounded-lg text-gray-600 sm:text-sm cursor-not-allowed">
                    </div>
                </div>

                <hr class="border-gray-100">

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                    <!-- Input Jumlah Keluar -->
                    <div>
                        <label for="jumlah_keluar" class="block text-sm font-medium text-gray-700">Jumlah Keluar</label>
                        <div class="mt-1 relative rounded-md shadow-sm">
                            <!-- Menambahkan value data lama -->
                            <input type="number" name="jumlah_keluar_baru" id="jumlah_keluar" required min="1" 
                                value="<%= dataObat.jumlah_keluar %>"
                                class="block w-full px-4 py-2.5 border border-gray-300 rounded-lg shadow-sm focus:ring-yellow-500 focus:border-yellow-500 sm:text-sm">
                            <div class="absolute inset-y-0 right-0 pr-4 flex items-center pointer-events-none">
                                <span class="text-gray-500 sm:text-sm">Unit</span>
                            </div>
                        </div>
                    </div>

                    <!-- Input Tanggal Keluar -->
                    <% 
                        // Mengubah format tanggal MySQL ke YYYY-MM-DD
                        let d = new Date(dataObat.tanggal_keluar);
                        let bulan = '' + (d.getMonth() + 1);
                        let hari = '' + d.getDate();
                        let tahun = d.getFullYear();

                        if (bulan.length < 2) bulan = '0' + bulan;
                        if (hari.length < 2) hari = '0' + hari;
                        let formatTanggal = [tahun, bulan, hari].join('-');
                    %>
                    <div>
                        <label for="tanggal_keluar" class="block text-sm font-medium text-gray-700">Tanggal Keluar</label>
                        <div class="mt-1">
                            <!-- Menambahkan value tanggal lama -->
                            <input type="date" name="tanggal_keluar" id="tanggal_keluar" required
                                value="<%= formatTanggal %>"
                                class="block w-full px-4 py-2.5 border border-gray-300 rounded-lg shadow-sm focus:ring-yellow-500 focus:border-yellow-500 sm:text-sm text-gray-700">
                        </div>
                    </div>
                </div>

                <!-- Input Keterangan -->
                <div>
                    <label for="keterangan" class="block text-sm font-medium text-gray-700">Keterangan / Tujuan</label>
                    <div class="mt-1">
                        <!-- Menambahkan value keterangan lama di dalam tag textarea -->
                        <textarea name="keterangan" id="keterangan" rows="3" required
                            class="block w-full px-4 py-2.5 border border-gray-300 rounded-lg shadow-sm focus:ring-yellow-500 focus:border-yellow-500 sm:text-sm"><%= dataObat.keterangan %></textarea>
                    </div>
                </div>

                <!-- Tombol Aksi -->
                <div class="pt-4 flex items-center justify-end space-x-3 border-t border-gray-100">
                    <a href="/" class="px-4 py-2.5 bg-white border border-gray-300 rounded-lg text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none transition-colors">
                        Batal
                    </a>
                    <button type="submit" class="px-4 py-2.5 bg-yellow-600 border border-transparent rounded-lg text-sm font-medium text-white hover:bg-yellow-700 focus:outline-none shadow-sm transition-colors">
                        Simpan Perubahan
                    </button>
                </div>
            </form>
        </div>

    </main>
</body>
</html>